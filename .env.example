# Copy this file to .env.local and paste the Web app values from Firebase.
# These are public app identifiers; Firestore Security Rules protect the data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The final public URL, used for social sharing metadata.
NEXT_PUBLIC_SITE_URL=
